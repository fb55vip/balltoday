const SITE_URL = "https://www.fb55vip.com";
const CONTENT_API = "https://balltoday-content-api.noppdsoma.workers.dev";

function xml(value = "") {
  return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/\"/g, "&quot;").replace(/'/g, "&apos;");
}

function safeImageUrl(value) {
  try {
    const url = new URL(value, CONTENT_API);
    return url.protocol === "https:" || url.protocol === "http:" ? url.href : "";
  } catch (_) {
    return "";
  }
}

export async function onRequestGet() {
  try {
    const response = await fetch(`${CONTENT_API}/api/sitemap`, { headers: { Accept: "application/json" } });
    if (!response.ok) throw new Error(`Image sitemap API ${response.status}`);
    const data = await response.json();
    const articles = (Array.isArray(data?.articles) ? data.articles : [])
      .map((article) => ({ ...article, image: safeImageUrl(article.cover_image || article.image_url) }))
      .filter((article) => article?.slug && article.image);

    const body = `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">\n${articles.map((article) => `  <url>\n    <loc>${xml(`${SITE_URL}/article?slug=${encodeURIComponent(article.slug)}`)}</loc>\n    <image:image>\n      <image:loc>${xml(article.image)}</image:loc>\n      ${article.title ? `<image:title>${xml(article.title)}</image:title>` : ""}\n    </image:image>\n  </url>`).join("\n")}\n</urlset>`;
    return new Response(body, { headers: { "Content-Type": "application/xml; charset=UTF-8", "Cache-Control": "public, max-age=0, s-maxage=300" } });
  } catch (error) {
    return new Response("Image sitemap temporarily unavailable", { status: 503, headers: { "Content-Type": "text/plain; charset=UTF-8" } });
  }
}
