const SITE_URL = "https://www.fb55vip.com";
const CONTENT_API = "https://balltoday-content-api.noppdsoma.workers.dev";

function xml(value = "") {
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\"/g, "&quot;")
    .replace(/'/g, "&apos;");
}

function iso(value) {
  const date = new Date(value || "");
  return Number.isNaN(date.getTime()) ? "" : date.toISOString();
}

async function getPublishedArticles() {
  const response = await fetch(`${CONTENT_API}/api/sitemap`, {
    headers: { Accept: "application/json" }
  });
  if (!response.ok) throw new Error(`Sitemap API ${response.status}`);
  const data = await response.json();
  return Array.isArray(data?.articles) ? data.articles : [];
}

export async function onRequestGet() {
  const staticUrls = [
    `${SITE_URL}/`,
    `${SITE_URL}/analysis`,
    `${SITE_URL}/news`,
    `${SITE_URL}/knowledge`,
    `${SITE_URL}/about.html`,
    `${SITE_URL}/author.html`,
    `${SITE_URL}/contact.html`,
    `${SITE_URL}/privacy.html`,
    `${SITE_URL}/leagues`,
    `${SITE_URL}/leagues/premier-league`,
    `${SITE_URL}/leagues/la-liga`,
    `${SITE_URL}/leagues/serie-a`,
    `${SITE_URL}/leagues/bundesliga`,
    `${SITE_URL}/leagues/ligue-1`,
    `${SITE_URL}/leagues/champions-league`
  ];

  try {
    const articles = await getPublishedArticles();
    const rows = [
      ...staticUrls.map((loc) => ({ loc, lastmod: "" })),
      ...articles
        .filter((article) => article?.slug)
        .map((article) => ({
          loc: `${SITE_URL}/article?slug=${encodeURIComponent(article.slug)}`,
          lastmod: iso(article.updated_at || article.published_at || article.created_at)
        }))
    ];
    const unique = [...new Map(rows.map((row) => [row.loc, row])).values()];
    const body = `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${unique.map((row) => `  <url><loc>${xml(row.loc)}</loc>${row.lastmod ? `<lastmod>${xml(row.lastmod)}</lastmod>` : ""}</url>`).join("\n")}\n</urlset>`;
    return new Response(body, { headers: { "Content-Type": "application/xml; charset=UTF-8", "Cache-Control": "public, max-age=0, s-maxage=300" } });
  } catch (error) {
    return new Response("Sitemap temporarily unavailable", { status: 503, headers: { "Content-Type": "text/plain; charset=UTF-8" } });
  }
}
