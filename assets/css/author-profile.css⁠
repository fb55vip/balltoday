.author-shell{width:min(1080px,calc(100% - 32px));margin:0 auto;padding:28px 0 60px}.author-shell nav{margin-bottom:20px;color:#9eabbc}.author-shell nav a{color:#fff}.author-hero{display:flex;gap:22px;align-items:center;padding:24px;border:1px solid #283243;border-radius:20px;background:#0a121e;margin-bottom:30px}.author-hero>img{width:128px;height:128px;border-radius:50%;object-fit:cover;border:3px solid #ef1737}.author-hero h1{margin:4px 0;font-size:clamp(28px,5vw,46px)}.author-hero p{color:#aeb8c7}.author-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.author-links a{padding:7px 12px;border:1px solid #8f1730;border-radius:999px;color:#fff;text-decoration:none}.author-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.author-article{overflow:hidden;border:1px solid #283243;border-radius:16px;background:#0a121e}.author-article a{display:block;color:#fff;text-decoration:none}.author-article img{width:100%;aspect-ratio:16/9;object-fit:cover}.author-article div{padding:14px}.author-article h2{font-size:18px;margin:6px 0}.author-article p,.author-article span{color:#aeb8c7;font-size:13px}@media(max-width:720px){.author-hero{align-items:flex-start}.author-hero>img{width:84px;height:84px}.author-grid{grid-template-columns:1fr 1fr}}@media(max-width:460px){.author-grid{grid-template-columns:1fr}}
.author-links a{display:inline-flex!important;align-items:center;gap:7px}.author-links .social-icon{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;background:#172033;color:#fff;font:800 13px/1 Arial,sans-serif}.author-links .social-icon--facebook{background:#1877f2}.author-links .social-icon--line{background:#06c755}.author-links .social-icon--instagram{background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045)}.author-links .social-icon--tiktok{background:#111;text-shadow:-1px 0 #25f4ee,1px 0 #fe2c55}.author-links .social-icon--youtube{background:#f00}.author-links .social-icon--x{background:#050505}
