.share-pack{margin-top:20px;padding:16px;border:1px solid var(--border);border-radius:16px;background:#08101a}.share-pack summary{cursor:pointer;font-weight:900;color:#fff;margin-bottom:14px}.share-actions{display:flex;gap:8px;flex-wrap:wrap}.share-actions button{flex:1 1 150px}
.profile-avatar-preview{display:block;width:112px;height:112px;border-radius:50%;object-fit:cover;border:2px solid #e81536;background:#06090f;margin-top:10px}
.social-link-form{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px!important;max-width:none!important}.span-2{grid-column:1/-1}
.social-links-list,.audit-list{display:grid;gap:12px;margin-top:20px}.social-link-card,.audit-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;padding:15px;border:1px solid var(--border);border-radius:14px;background:#09101a}.social-link-card h3,.audit-item h3{margin:0 0 5px}.social-link-card p,.audit-item p{margin:3px 0;color:var(--muted);font-size:13px;overflow-wrap:anywhere}.social-link-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.platform-icon{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#161e2b;margin-right:8px}.audit-item{grid-template-columns:1fr}.audit-time{color:#ff8da0!important;font-weight:700}
.seo-health{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:16px}.seo-health div{padding:14px;border:1px solid var(--border);border-radius:12px;background:#09101a}.seo-health strong{display:block;font-size:24px;color:#fff}.seo-health span{font-size:12px;color:var(--muted)}
@media(max-width:720px){.social-link-form,.seo-health{grid-template-columns:1fr}.span-2{grid-column:auto}.social-link-card{grid-template-columns:1fr}.social-link-actions{justify-content:flex-start}}
